# Optional real LLM fallback configuration.
# Keep secrets out of the browser and out of source control.
# Gemini via Google's OpenAI-compatible chat-completions endpoint:
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_API_MODE=chat
LLM_PROVIDER=Google Gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your-gemini-api-key-here

# Tuning / reproducibility
LLM_TIMEOUT=45
LLM_MAX_RETRIES=2
LLM_MAX_CONTEXT=7000
# Optional provider-specific headers, as a JSON object
# LLM_EXTRA_HEADERS={"HTTP-Referer":"https://localhost:8000","X-Title":"Mini Transpiler"}
