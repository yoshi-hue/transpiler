{
  "manifest_version": 3,
  "name": "Local report screenshot runner",
  "version": "1.0",
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8765/*",
        "http://127.0.0.1:8767/*",
        "http://127.0.0.1:8768/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_idle"
    }
  ]
}